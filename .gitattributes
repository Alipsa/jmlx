#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# The release-smoke tuple file is parsed line by line by the shell preflight and the Gradle
# reader, which must agree byte for byte; pin LF so a core.autocrlf=true checkout cannot
# rewrite it to CRLF and split the two parsers.
tools/release-smoke/released-8.1.properties text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary

# Preserve the byte-pinned Phase 8.2 evidence across checkout settings.
req/benchmarks/phase8-2/** -text
tools/decode-baseline/workloads.json -text
req/plans/phase8-2-wp3-raw-digests.json -text
req/plans/phase8-2-wp4-raw-digests.json -text
