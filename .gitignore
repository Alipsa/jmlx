# Compiled class file
*.class

# Log file
*.log
# ...except the committed Phase 8.2 evidence host/worker records (digest-pinned in
# req/benchmarks/phase8-2/evidence-index.json and verified by Phase82SummaryVerifierTest)
!req/benchmarks/phase8-2/raw/**/*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Ignore Gradle project-specific cache directory
.gradle

# macOS Finder metadata
.DS_Store

# Ignore Gradle build output directory
build

# Ignore Kotlin plugin data
.kotlin
/.idea/

# Native toolchain artifacts (built/staged by scripts/bootstrap-native.sh)
/native/

# Hash-locked Python MLX reference environment (created explicitly on Apple Silicon)
/tools/decode-baseline/.venv/
/tools/mlx-oracle/.venv/
/tools/tokenizer-oracle/.venv/
/tools/image-oracle/.venv/
/tools/image-oracle/fast-comparison/.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Subagent-driven-development scratch workspace
/.superpowers/
/tools/release-smoke/build/
/tools/release-smoke/.gradle/
/tools/release-smoke/*/build/

# Opt-in real checkpoint downloads
/.tier-b/
/tools/decode-baseline/artifacts/
/tools/hf-reference/.venv/
/tools/qwen-vl-reference/.venv/
/tools/qwen35-reference/hf/.venv/
/tools/qwen35-reference/mlx/.venv/
