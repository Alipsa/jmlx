      ">": 2,
      "1": 3,
      "2": 4,
      "3": 5,
      "4": 6,
      "5": 7,
      "6": 8,
      "7": 9,
      "8": 10,
      "9": 11,
      "a": 13,
      "b": 14,
      "c": 15,
      "d": 16,
      "e": 17,
      "o": 18,
      "s": 19,
      "t": 20,
      "Ġ": 12
    },
    "merges": []
  },
