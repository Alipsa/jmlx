#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# The release-smoke tuple file is parsed line by line by the shell preflight and the Gradle
# reader, which must agree byte for byte; pin LF so a core.autocrlf=true checkout cannot
# rewrite it to CRLF and split the two parsers.
tools/release-smoke/released-8.1.properties text eol=lf
tools/release-smoke/released-8.4.json text eol=lf
req/native-license-inventory.json text eol=lf
jmlx-native-macos-arm64/NOTICE text eol=lf
jmlx-native-macos-arm64/THIRD-PARTY-NOTICES text eol=lf
jmlx-native-macos-arm64/LICENSE-APACHE-2.0 text eol=lf
jmlx-native-macos-arm64/LICENSE text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary

# Preserve the byte-pinned Phase 8.2 evidence across checkout settings.
req/benchmarks/phase8-2/** -text
tools/decode-baseline/workloads.json -text
req/plans/phase8-2-wp3-raw-digests.json -text
req/plans/phase8-2-wp4-raw-digests.json -text

# Preserve raw-byte scope/wording evidence, including upstream license whitespace.
req/plans/evidence/juffa-scope-wording-2026-11-21/** -text
req/plans/evidence/juffa-scope-wording-2026-11-21/LICENSE-CC-BY-SA-4.0 -whitespace
jmlx-native-macos-arm64/LICENSE-CC-BY-SA-4.0 text eol=lf whitespace=-blank-at-eof

# Implementation approval and validation evidence is byte-pinned.
req/plans/evidence/juffa-implementation-2026-11-22/** -text
req/native-authored-attributions.json text eol=lf

# Preserve post-merge native distribution review evidence across checkout settings.
req/plans/evidence/native-distribution-review-2026-11-22/** -text

# Preserve exact RC2 report, runtime, metadata and review evidence bytes.
req/plans/evidence/rc2-final-review-2026-11-22/** -text
# Exact Gradle stdout contains a trailing space in its daemon shutdown message.
req/plans/evidence/rc2-final-review-2026-11-22/*.log whitespace=-blank-at-eol

# Preserve RC3 preparation recovery evidence bytes.
req/plans/evidence/rc3-preparation-2026-11-23/** -text

# Preserve RC3 pre-tag verification evidence bytes.
req/plans/evidence/rc3-pre-tag-2026-11-23/** -text
req/plans/evidence/rc3-pre-tag-2026-11-23/**/*.log whitespace=-blank-at-eol
req/plans/evidence/rc3-pre-tag-2026-11-23/*.log whitespace=-blank-at-eol
