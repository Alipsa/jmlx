<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.alipsa.jmlx-release-runner</string>
  <key>UserName</key><string>jmlxrunner</string>
  <key>GroupName</key><string>staff</string>
  <key>ProgramArguments</key>
  <array><string>/Users/jmlxrunner/actions-runner/runsvc.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/jmlxrunner/actions-runner</string>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>SessionCreate</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/jmlxrunner</string>
    <key>USER</key><string>jmlxrunner</string>
    <key>LOGNAME</key><string>jmlxrunner</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ACTIONS_RUNNER_SVC</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/jmlxrunner/Library/Logs/jmlx-release-runner/stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/jmlxrunner/Library/Logs/jmlx-release-runner/stderr.log</string>
</dict>
</plist>
